Cell["Disease free equilibrium fractions S*, V*, P* as functions of chi1, chi2, chi3.", "Text"],

Cell[BoxData[{
 RowBox[{"sdfe", "=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"mN", "[", 
      RowBox[{"[", 
       RowBox[{"i", ",", "j"}], "]"}], "]"}], "\[Times]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{
         FractionBox[
          RowBox[{"m\[Chi]1", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "j"}], "]"}], "]"}], 
          RowBox[{"\[Omega]v", "+", 
           RowBox[{"\[Epsilon]2", " ", 
            RowBox[{"m\[Chi]2", "\[LeftDoubleBracket]", 
             RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}]}]}]], 
         RowBox[{"(", 
          RowBox[{"1", "+", 
           FractionBox[
            RowBox[{"\[Epsilon]2", " ", 
             RowBox[{"m\[Chi]2", "\[LeftDoubleBracket]", 
