          RowBox[{"[", 
           RowBox[{"i", ",", "j", ",", "p", ",", "q"}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "m"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "1", ",", "n"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"p", ",", "1", ",", "m"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"q", ",", "1", ",", "n"}], "}"}]}], "]"}], "]"}], ",", 
      RowBox[{"m", "\[Times]", "n"}]}], "]"}], "//", "Quiet"}]}], 
  ";"}]], "Input",
