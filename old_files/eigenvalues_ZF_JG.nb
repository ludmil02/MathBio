Cell["Y and Z, and the block diagonal Omega_mat[[i]] = diag(Y_ij, Z_ij).", "Text"],

Cell[BoxData[{
 RowBox[{"Y", "=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"v\[Psi]S", "[", 
      RowBox[{"[", "j", "]"}], "]"}], "\[Times]", 
     RowBox[{"vS", "[", 
      RowBox[{"[", "i", "]"}], "]"}], "\[Times]", 
     RowBox[{"ma", "[", 
      RowBox[{"[", 
       RowBox[{"i", ",", "j"}], "]"}], "]"}], "\[Times]", 
     RowBox[{"v\[Beta]", "[", 
      RowBox[{"[", "j", "]"}], "]"}], "\[Times]", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"sdfe", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "j"}], "]"}], "]"}], "/", 
       RowBox[{"mN", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "j"}], "]"}], "]"}]}], ")"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", "m"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}]}], "\n", 
 RowBox[{"Z", "=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"v\[Psi]S", "[", 
      RowBox[{"[", "j", "]"}], "]"}], "\[Times]", 
     RowBox[{"vS", "[", 
      RowBox[{"[", "i", "]"}], "]"}], "\[Times]", 
     RowBox[{"ma", "[", 
      RowBox[{"[", 
       RowBox[{"i", ",", "j"}], "]"}], "]"}], "\[Times]", 
     RowBox[{"v\[Beta]", "[", 
      RowBox[{"[", "j", "]"}], "]"}], "\[Times]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", "\[Epsilon]1"}], ")"}], "\[Times]", 
         RowBox[{"vdfe", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j"}], "]"}], "]"}]}], "+", 
        RowBox[{"pdfe", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "j"}], "]"}], "]"}]}], ")"}], "/", 
      RowBox[{"mN", "[", 
       RowBox[{"[", 
        RowBox[{"i", ",", "j"}], "]"}], "]"}]}]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", "m"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}]}]}], "Input",
