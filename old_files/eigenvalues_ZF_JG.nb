Cell["Contact matrix, flattened to m n by m n and then doubled into 2n by 2n blocks ccMat[[i,p]].", "Text"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ccM", "=", 
   RowBox[{
    RowBox[{"Partition", "[", 
     RowBox[{
      RowBox[{"Flatten", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
