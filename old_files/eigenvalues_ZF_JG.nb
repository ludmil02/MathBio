Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Using", " ", "the", " ", "mixing", " ", "matrix", " ", "cM", " ", "to", 
    " ", "add", " ", "double", " ", 
    RowBox[{"rows", ".", " ", "There"}], " ", "are", " ", 
    RowBox[{"m", "^", "2"}], " ", "block", " ", "matrices", " ", "each", " ", 
