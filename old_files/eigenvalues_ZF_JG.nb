                   "]"}]}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"r", ",", "1", ",", "n"}], "}"}]}], "]"}], "]"}]}], 
            "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}], ",", "1"}], 
