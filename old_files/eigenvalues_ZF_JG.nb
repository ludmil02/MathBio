                    RowBox[{
                    RowBox[{"n", " ", 
                    RowBox[{"(", 
                    RowBox[{"p", "-", "1"}], ")"}]}], "+", "r"}]}], "]"}], 
                   "]"}]}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"r", ",", "1", ",", "n"}], "}"}]}], "]"}], "]"}], 
             ",", 
             RowBox[{"Flatten", "[", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"ccM", "[", 
                   RowBox[{"[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"i", "-", "1"}], ")"}], " ", "n"}], "+", "k"}], 
